; Maps the Windows locale name (HKCU\Control Panel\International\LocaleName,
; e.g. "tr-TR", "zh-Hans-CN") to a Tactile language code, English by default.
Function TactileDetectInstallerLanguage
    StrCpy $0 "en"
    ReadRegStr $1 HKCU "Control Panel\International" "LocaleName"
    StrCmp $1 "" tact_lang_done
    ; Chinese locale names carry the script, so they are matched in full first.
    StrCmp $1 "zh-Hant" tact_lang_zh_TW
    StrCmp $1 "zh-HK" tact_lang_zh_TW
    StrCmp $1 "zh-MO" tact_lang_zh_TW
    StrCmp $1 "zh-CN" tact_lang_zh_CN
    StrCmp $1 "zh-SG" tact_lang_zh_CN
    StrCmp $1 "zh-Hans" tact_lang_zh_CN
    StrCpy $2 $1 2
    StrCmp $2 "zh" tact_lang_zh_CN
    StrCpy $2 $1 3
    StrCmp $2 "fil" tact_lang_fil
    StrCpy $2 $1 2
    StrCmp $2 "af" tact_lang_af
    StrCmp $2 "am" tact_lang_am
    StrCmp $2 "ar" tact_lang_ar
