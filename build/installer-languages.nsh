; Selects the detected language inside the already-populated combobox.
Function TactileSelectInstallerLanguage
    StrCmp $TactileSelectedLanguage "af" 0 +3
    SendMessage $TactileLangCombo ${CB_SETCURSEL} 0 0
    Goto tact_select_done
    StrCmp $TactileSelectedLanguage "am" 0 +3
    SendMessage $TactileLangCombo ${CB_SETCURSEL} 1 0
