{
  "name": "tactile",
  "productName": "Tactile",
  "version": "1.0.0",
  "description": "Transform your keyboard into a premium mechanical experience with satisfying sound profiles that boost your focus and typing rhythm.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/run-tests.js",
    "test:i18n": "node tools/i18n-status.js && node tools/i18n/placeholders.js",
    "build:icons": "node tools/build-icons.js",
    "build:win": "node tools/build-icons.js && electron-builder --win nsis --x64 && node tools/refresh-icon-cache.js",
    "build:appx": "node tools/build-icons.js && electron-builder --win appx --x64",
    "build:mac": "electron-builder -m",
    "build:linux": "electron-builder -l",
    "build:clean": "node tools/clean-dist.js",
    "capture": "electron tools/capture.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "keyboard",
    "mechanical-keyboard",
    "key-sounds",
    "typing",
    "electron",
    "windows",
    "accessibility"
  ],
  "homepage": "https://vellium.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emirtdede/tactile.git"
  },
  "bugs": {
    "url": "https://github.com/emirtdede/tactile/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Vellium.dev",
    "email": "support@vellium.dev",
    "url": "https://vellium.dev"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.vellium.tactile",
    "copyright": "Copyright (c) 2026 Vellium. All rights reserved.",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "emirtdede",
        "repo": "tactile",
        "releaseType": "release"
      }
    ],
    "appx": {
      "publisher": "CN=VelliumPublisher",
      "identityName": "TactileApp",
      "applicationId": "Tactile",
      "publisherDisplayName": "Vellium"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "include": "./build/installer.nsh",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "uninstallDisplayName": "Tactile"
    },
    "win": {
      "publisherName": "Vellium.dev",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "1.17.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "fs-extra": "9.1.0",
    "sharp": "0.35.5"
  }
}
